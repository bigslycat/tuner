{
  "extends": "./tsconfig.base.json",

  "compilerOptions": {
    "composite": true,

    "target": "esnext",
    "lib": ["ESNext", "DOM"],

    "module": "esnext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",

    "types": ["@rsbuild/core/types"],

    "rootDir": "./src",
    "outDir": "./.tsbuild/app",
    "declaration": true,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "./.tsbuild/app.tsbuildinfo"
  },

  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],

  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__tests__/**",
    "src/test/**",
    "src/tests/**"
  ]
}
