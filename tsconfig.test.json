{
  "extends": "./tsconfig.base.json",

  "compilerOptions": {
    "composite": true,

    "target": "esnext",
    "lib": ["ESNext", "DOM"],

    "module": "esnext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",

    "types": ["node", "@rsbuild/core/types"],

    "noEmit": true,
    "tsBuildInfoFile": "./.tsbuild/test.tsbuildinfo"
  },

  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test/**/*.ts",
    "src/test/**/*.tsx",
    "rstest.setup.ts"
  ],

  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
